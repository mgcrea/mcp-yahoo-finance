# Yahoo Finance MCP — all variables are OPTIONAL (the API needs no auth).

# Verbose stderr logging ("1" / "true").
YAHOO_FINANCE_DEBUG=

# Max concurrent requests to Yahoo (helps avoid 429 rate limiting). Default 4.
YAHOO_FINANCE_CONCURRENCY=4

# Per-request timeout in milliseconds. Default 30000.
YAHOO_FINANCE_REQUEST_TIMEOUT_MS=30000

# Escape hatch: use a browser's cookie instead of the automatic handshake, if
# Yahoo's consent flow changes (e.g. "A3=...", or "A3=...; T=...; Y=..." for a
# signed-in session). The server asks Yahoo for the crumb that goes with it.
# This does NOT get past a 429: Yahoo checks the TLS fingerprint on every
# request, cookies or not.
YAHOO_FINANCE_COOKIE=
# Rarely needed: a crumb is derived from the cookie, and a supplied one that
# Yahoo rejects is replaced the same way.
YAHOO_FINANCE_CRUMB=

# "1" registers the watchlist and portfolio tools that change the account. Needs a
# signed-in YAHOO_FINANCE_COOKIE (A3, T and Y). Off by default.
YAHOO_FINANCE_ALLOW_WRITES=
